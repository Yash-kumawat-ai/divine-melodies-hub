tsx// components/chant/ChantCounter.tsx

'use client'
import { useState, useEffect } from 'react'
import { createClient } from '@/lib/supabase'
import { motion } from 'framer-motion'

const SANKALPAS = [
  { name: 'Dhana Sampath', label: 'Wealth & prosperity' },
  { name: 'Arogya', label: 'Health & healing' },
  { name: 'Vivaha', label: 'Marriage & love' },
  { name: 'Vidya', label: 'Education & wisdom' },
]

export default function ChantCounter({ userId, deity }) {
  const [count, setCount] = useState(0)
  const [target] = useState(108)
  const [sankalp, setSankalp] = useState(SANKALPAS[0])
  const supabase = createClient()

  const handleChant = async () => {
    const newCount = count + 1
    setCount(newCount)
    
    // Play tap sound
    new Audio('/sounds/chant-tap.mp3').play()
    
    // Haptic feedback (mobile)
    if (navigator.vibrate) navigator.vibrate(50)
    
    if (newCount === target) {
      // Save to DB + award punya
      await supabase.from('chant_sessions').insert({
        user_id: userId,
        deity: deity.name,
        mantra: deity.mantra,
        count: target,
        target,
        completed: true,
        sankalp: sankalp.name,
      })
      // Award 50 punya coins
      await awardPunya(userId, 50)
    }
  }

  const progress = (count / target) * 100
  const milestones = [27, 54, 81, 108]

  return (
    <div className="flex flex-col items-center gap-6 p-6 
      bg-black/60 backdrop-blur-sm rounded-2xl">
      
      {/* Sankalp Banner */}
      <div className="bg-black/40 px-6 py-3 rounded-xl text-center">
        <p className="text-white font-semibold">
          Today's Sankalp: {sankalp.name}
        </p>
        <p className="text-yellow-300 text-sm">{sankalp.label}</p>
      </div>

      {/* Mantra */}
      <p className="text-orange-400 text-xl font-bold italic">
        {deity.mantra}
      </p>

      {/* Counter row */}
      <div className="flex items-center gap-8 w-full justify-center">
        <span className="text-white text-3xl font-bold">{count}</span>
        
        {/* Tap to Chant button */}
        <motion.button
          whileTap={{ scale: 0.9 }}
          onClick={handleChant}
          className="w-28 h-28 rounded-full bg-gradient-to-b 
            from-yellow-400 to-orange-500 flex flex-col 
            items-center justify-center shadow-2xl 
            border-4 border-yellow-200 cursor-pointer"
        >
          <span className="text-white text-sm">Tap to</span>
          <span className="text-white text-xl font-bold">Chant</span>
        </motion.button>
        
        <span className="text-white text-3xl font-bold">{target}</span>
      </div>

      {/* Progress milestones */}
      <div className="w-full">
        <div className="flex justify-between mb-2">
          <span className="text-white text-sm">Your Progress</span>
          <span className="text-white text-sm">Next Milestone</span>
        </div>
        
        {/* Progress bar */}
        <div className="relative w-full h-2 bg-gray-700 rounded-full">
          <motion.div
            className="h-full bg-yellow-400 rounded-full"
            animate={{ width: `${progress}%` }}
          />
        </div>
        
        {/* Milestone markers */}
        <div className="flex justify-between mt-2">
          {milestones.map((m, i) => (
            <div key={m} className="flex flex-col items-center">
              <div className={`w-8 h-8 rounded-full flex items-center 
                justify-center text-xs font-bold border-2
                ${count >= m 
                  ? 'bg-yellow-400 border-yellow-200 text-black' 
                  : 'bg-gray-700 border-gray-500 text-white'}`}>
                {i === 3 ? '🌸' : m}
              </div>
              <span className="text-gray-400 text-xs mt-1">
                {[25,50,75,100][i]}%
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

