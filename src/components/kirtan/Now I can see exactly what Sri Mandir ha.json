'use client'
import { useState, useEffect } from 'react'
import { motion, AnimatePresence } from 'framer-motion'

const DEITIES = [
  { name: 'Vishnu ji', image: '/deities/vishnu.png', 
    color: '#FFB300', mantra: 'Om Namo Narayanaya' },
  { name: 'Durga Maa', image: '/deities/durga.png', 
    color: '#FF6B00', mantra: 'Om Dum Durgayei Namaha' },
  { name: 'Shiva ji', image: '/deities/shiva.png', 
    color: '#4A90D9', mantra: 'Om Namah Shivaya' },
]

export default function DeityCanvas({ userId, deity }) {
  const [offerings, setOfferings] = useState([])
  const [showBell, setShowBell] = useState(false)

  const triggerOffering = (type) => {
    // Add floating animation particles
    const newOffering = {
      id: Date.now(),
      type, // 'marigold' | 'rose' | 'diya'
      x: Math.random() * 80 + 10, // random x position %
    }
    setOfferings(prev => [...prev, newOffering])
    setTimeout(() => {
      setOfferings(prev => 
        prev.filter(o => o.id !== newOffering.id))
    }, 2000)
  }

  return (
    <div className="relative h-screen w-full overflow-hidden">
      {/* Temple background */}
      <div 
        className="absolute inset-0 bg-cover bg-center"
        style={{ backgroundImage: `url(/temple-bg.jpg)` }}
      />
      
      {/* Deity image */}
      <motion.img
        src={deity.image}
        className="absolute bottom-32 left-1/2 -translate-x-1/2 h-[65vh] object-contain z-10"
        animate={{ y: [0, -8, 0] }}
        transition={{ repeat: Infinity, duration: 3 }}
      />

      {/* Floating offerings layer */}
      <AnimatePresence>
        {offerings.map(offering => (
          <motion.img
            key={offering.id}
            src={`/offerings/${offering.type}.png`}
            className="absolute w-10 h-10 z-20"
            style={{ left: `${offering.x}%`, bottom: '40%' }}
            initial={{ opacity: 1, y: 0, rotate: 0 }}
            animate={{ 
              opacity: 0, 
              y: -200, 
              rotate: Math.random() * 360 
            }}
            exit={{ opacity: 0 }}
            transition={{ duration: 2 }}
          />
        ))}
      </AnimatePresence>

      {/* Bell */}
      <motion.div
        className="absolute top-24 left-1/2 -translate-x-1/2 z-20 cursor-pointer"
        animate={showBell ? { rotate: [0, 20, -20, 0] } : {}}
        onClick={() => {
          setShowBell(true)
          // Play bell audio
          new Audio('/sounds/bell.mp3').play()
          setTimeout(() => setShowBell(false), 1000)
        }}
      >
        🔔
      </motion.div>

      {/* Offering Panel */}
      <OfferingPanel onOffer={triggerOffering} />
    </div>
  )
}

