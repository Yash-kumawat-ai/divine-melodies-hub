🗄️ Supabase Schema
sql-- Users & Temple Setup
CREATE TABLE user_temples (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES auth.users,
  deity_name TEXT,           -- 'Vishnu', 'Durga', 'Shiva'
  deity_image_url TEXT,
  temple_name TEXT,          -- 'Shri Hari Vishnu'
  punya_coins INTEGER DEFAULT 0,
  created_at TIMESTAMPTZ
);

-- Streak System
CREATE TABLE devotion_streaks (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES auth.users,
  current_streak INTEGER DEFAULT 0,
  longest_streak INTEGER DEFAULT 0,
  last_worship_date DATE,
  total_presence_days INTEGER DEFAULT 0
);

-- Chanting Sessions
CREATE TABLE chant_sessions (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES auth.users,
  deity TEXT,
  mantra TEXT,
  count INTEGER,             -- how many chants done
  target INTEGER DEFAULT 108,
  completed BOOLEAN,
  sankalp TEXT,              -- 'Dhana Sampath', 'Health'
  created_at TIMESTAMPTZ
);

-- Offerings
CREATE TABLE offerings (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES auth.users,
  deity TEXT,
  offering_type TEXT,        -- 'marigold','rose','diya'
  is_premium BOOLEAN,
  punya_earned INTEGER,
  offered_at TIMESTAMPTZ
);

-- Community / Sangrah
CREATE TABLE community_sessions (
  id UUID PRIMARY KEY,
  session_name TEXT,
  deity TEXT,
  scheduled_time TIMESTAMPTZ,
  host_user_id UUID,
  participant_count INTEGER DEFAULT 0,
  is_live BOOLEAN DEFAULT false,
  entry_fee INTEGER DEFAULT 0  -- ₹ for paid sessions
);

-- Community Participants (Realtime)
CREATE TABLE session_participants (
  session_id UUID REFERENCES community_sessions,
  user_id UUID,
  joined_at TIMESTAMPTZ,
  PRIMARY KEY (session_id, user_id)
);

-- AI Pandit Queries
CREATE TABLE pandit_queries (
  id UUID PRIMARY KEY,
  user_id UUID,
  rashi TEXT,
  problem_type TEXT,
  question TEXT,
  ai_response TEXT,
  punya_spent INTEGER DEFAULT 5,
  created_at TIMESTAMPTZ
);

-- Monetization — Premium Unlocks
CREATE TABLE premium_offerings (
  id UUID PRIMARY KEY,
  name TEXT,                 -- 'Lotus', 'Vaijayanti'
  unlock_type TEXT,          -- 'days' or 'coins' or 'paid'
  unlock_value INTEGER,      -- 20 days or ₹49
  image_url TEXT
);

