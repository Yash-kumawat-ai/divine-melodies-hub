    currency: 'INR',
    name: 'Divya Mandir',
    description,
    order_id: orderId,
    theme: { color: '#FF6B00' },
    handler: async (response) => {
      // Verify + unlock premium feature
      await verifyAndUnlock(response)
    }
  }
  
  const rzp = new window.Razorpay(options)
  rzp.open()
}

