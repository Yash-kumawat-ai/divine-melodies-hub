export default function OfferingPanel({ onOffer, presenceDays }) {
  const [activeTab, setActiveTab] = useState('Flowers')
  const [selectedOffering, setSelectedOffering] = useState(null)

  const handleOffer = async (item) => {
    if (item.locked && presenceDays < item.unlockDays) {
      // Show unlock modal
      return
    }
    onOffer(item.name.toLowerCase())
    // Award punya + save to DB
    await saveOffering(item)
  }

  return (
    <div className="absolute bottom-20 left-0 right-0 
      bg-black/80 backdrop-blur-md rounded-t-3xl p-4">
      
      {selectedOffering && (
        <p className="text-white text-center mb-3 font-semibold">
          Offer {selectedOffering} to Vishnu ji
        </p>
      )}

      {/* Tabs */}
      <div className="flex gap-2 overflow-x-auto pb-2 mb-4 
        scrollbar-hide">
        {OFFERING_TABS.map(tab => (
          <button
            key={tab}
            onClick={() => setActiveTab(tab)}
            className={`px-4 py-1.5 rounded-full text-sm 
              whitespace-nowrap font-medium transition-all
              ${activeTab === tab 
                ? 'bg-orange-500 text-white' 
                : 'text-gray-400 border border-gray-600'}`}
          >
            {tab}
          </button>
        ))}
      </div>

      {/* Items grid */}
      <div className="flex gap-4 overflow-x-auto pb-2">
        {FLOWERS.map(item => (
          <button
            key={item.name}
            onClick={() => handleOffer(item)}
            className="flex flex-col items-center gap-1 
              min-w-16 relative"
          >
            <div className={`w-16 h-16 rounded-full 
              flex items-center justify-center text-3xl
              border-2 transition-all
              ${item.locked 
                ? 'border-dashed border-gray-500 opacity-50' 
                : 'border-orange-400 bg-orange-900/30'}`}>
              {item.icon}
              {item.locked && (
                <div className="absolute top-0 right-0 
                  bg-gray-700 rounded-full p-1">
                  🔒
                </div>
              )}
            </div>
            <span className="text-white text-xs">{item.name}</span>
            {item.locked && (
              <span className="text-gray-400 text-xs">
                {item.unlockDays} days
              </span>
            )}
          </button>
        ))}
      </div>

      {/* Presence counter */}
      <div className="mt-3 text-center">
        <span className="text-gray-300 text-sm">
          📅 Your Presence: {presenceDays} days
