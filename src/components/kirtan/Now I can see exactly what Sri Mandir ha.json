tsx// app/api/pandit/route.ts

import Anthropic from '@anthropic-ai/sdk'

const client = new Anthropic()

export async function POST(req) {
  const { rashi, problem, question } = await req.json()

  const message = await client.messages.create({
    model: 'claude-sonnet-4-20250514',
    max_tokens: 1024,
    messages: [{
      role: 'user',
      content: `You are a wise and learned Hindu Pandit with deep 
knowledge of Vedic astrology, pujas, mantras and remedies. 
Respond warmly in simple Hindi mixed with English.

Devotee's Rashi: ${rashi}
Problem Area: ${problem}
Their Question: ${question}

Please provide:
1. A specific puja recommendation with timing
2. A powerful mantra for their situation (3-5 words)
3. A practical remedy (saral upay)
4. Words of encouragement (ashirwad)

Keep response warm, personal and under 200 words.`
    }]
  })

  return Response.json({ 
    answer: message.content[0].text 
  })
}

Feature 5: Community Temple (Realtime)
tsx// components/community/LiveDevotees.tsx

'use client'
import { useEffect, useState } from 'react'
import { createClient } from '@/lib/supabase'

export default function LiveDevotees({ sessionId }) {
  const [devotees, setDevotees] = useState([])
  const supabase = createClient()

  useEffect(() => {
    // Supabase Realtime subscription
    const channel = supabase
      .channel(`session:${sessionId}`)
      .on('postgres_changes', {
        event: '*',
        schema: 'public',
        table: 'session_participants',
        filter: `session_id=eq.${sessionId}`
      }, (payload) => {
        fetchDevotees()
      })
      .subscribe()

    fetchDevotees()
    return () => supabase.removeChannel(channel)
  }, [sessionId])

  const fetchDevotees = async () => {
    const { data } = await supabase
      .from('session_participants')
      .select('*, users(name, avatar_url)')
      .eq('session_id', sessionId)
    setDevotees(data || [])
  }

  return (
    <div className="bg-black/40 rounded-2xl p-4">
      <div className="flex items-center gap-2 mb-3">
        <div className="w-2 h-2 rounded-full bg-green-400 
          animate-pulse" />
        <span className="text-white font-semibold">
          {devotees.length} devotees praying now
        </span>
      </div>
      
      <div className="flex flex-wrap gap-2">
        {devotees.map(d => (
          <div key={d.user_id} 
            className="flex flex-col items-center">
            <img 
              src={d.users?.avatar_url || '/default-avatar.png'}
              className="w-10 h-10 rounded-full border-2 
                border-orange-400"
            />
            <span className="text-xs text-gray-300 mt-1">
              {d.users?.name?.split(' ')[0]}
            </span>
          </div>
        ))}
      </div>
    </div>
  )
}

