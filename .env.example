# Supabase Configuration (Required)
# Get these from your Supabase project dashboard: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use either the anon key name (per Supabase docs) or the project's publishable key — both work in code.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Cloudinary Configuration (Required for image uploads)
# Get these from Cloudinary dashboard: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# App Configuration
VITE_APP_URL=http://localhost:8080